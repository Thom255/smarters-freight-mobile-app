# Expo inlines EXPO_PUBLIC_* vars into the app bundle at build time.
# The Laravel backend base URL (no trailing slash).
#   - iOS simulator / web: http://localhost:8001
#   - Android emulator:    http://10.0.2.2:8001
#   - Physical device:     http://<your-LAN-IP>:8001 (backend must bind 0.0.0.0)
# Remote hosting: set this to your deployed backend origin (e.g. https://api.example.com).
EXPO_PUBLIC_API_URL=http://192.168.1.102:8001
